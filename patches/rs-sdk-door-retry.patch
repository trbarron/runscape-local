diff --git a/sdk/test/door-retry.test.ts b/sdk/test/door-retry.test.ts
new file mode 100644
index 0000000..4e027fe
--- /dev/null
+++ b/sdk/test/door-retry.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, mock, test } from 'bun:test';
+import { ActionHelpers } from '../actions-helpers';
+import type { BotSDK } from '..';
+
+describe('door recovery after repositioning', () => {
+    test('opens a door when moving adjacent still leaves the target unreachable', async () => {
+        const helpers = new ActionHelpers({ waitForTicks: async () => {} } as unknown as BotSDK);
+        let doorOpen = false;
+        helpers.walkAdjacentTo = mock(async () => true);
+        helpers.tryOpenBlockingDoor = mock(async () => { doorOpen = true; return true; });
+        const action = mock(async () => doorOpen
+            ? { success: true, reason: undefined }
+            : { success: false, reason: 'cant_reach' });
+
+        const result = await helpers.withDoorRetry(action, r => r.reason === 'cant_reach', 2, { x: 2999, z: 3144 });
+
+        expect(result.success).toBe(true);
+        expect(action).toHaveBeenCalledTimes(3);
+        expect(helpers.walkAdjacentTo).toHaveBeenCalledTimes(1);
+        expect(helpers.tryOpenBlockingDoor).toHaveBeenCalledTimes(1);
+    });
+
+    test('stops within the retry bound when neither recovery works', async () => {
+        const helpers = new ActionHelpers({ waitForTicks: async () => {} } as unknown as BotSDK);
+        helpers.walkAdjacentTo = mock(async () => true);
+        helpers.tryOpenBlockingDoor = mock(async () => true);
+        const action = mock(async () => ({ success: false, reason: 'cant_reach' }));
+
+        const result = await helpers.withDoorRetry(action, () => true, 2, { x: 2999, z: 3144 });
+
+        expect(result.success).toBe(false);
+        expect(action).toHaveBeenCalledTimes(3);
+    });
+});
